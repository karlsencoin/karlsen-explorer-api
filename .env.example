# Copy to .env (never committed). All values below are placeholders.
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/karlsen
LISTEN_ADDR=127.0.0.1:8013
DB_MAX_CONNECTIONS=16
RUST_LOG=info
# karlsend gRPC endpoint (optional). Without it every response comes from the database.
KARLSEND_GRPC_URL=http://127.0.0.1:42110
NODE_TIMEOUT_MS=10000
# KLS/USDT ticker for /info/price and /info/market-data (default: public NonKYC endpoint).
# NONKYC_TICKER_URL=https://api.nonkyc.io/api/v2/ticker/KLS/USDT
# Blocks per second for the hashrate/halving formulas (legacy production value: 1).
# BPS=1
# KGI reward tracker SQLite database for /info/miners/* (opened read-only).
# KGI_TRACKER_DB=/opt/karlsen/kgi-backend/data/kgi.db
# KGI node map (/info/nodes, /info/peers/geo, /info/seeder-nodes). Defaults shown.
# The peer_geo table is written by the scanner's enrich_nodes.py, not by this API.
# DISCOVERED_NODES_FILE=/opt/karlsen/kgi-backend/data/discovered_nodes.json
# NODE_HISTORY_DB=/etc/karlsen/peer_geo.db
# NODE_HISTORY_WINDOW_SEC=604800
# ENRICH_HISTORY_DB=/opt/karlsen/kgi-backend/data/node_history.db
# GEO_CACHE_FILE=/opt/karlsen/kgi-backend/data/geo_cache.json
# SEEDER_HISTORY_FILE=/opt/karlsen/kgi-backend/data/seeder_history.json
# Operator token for /admin/seed-candidates (empty disables the endpoint).
# KGI_ADMIN_TOKEN=
