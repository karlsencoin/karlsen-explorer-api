      "description": "OK",
      "content": {
       "application/json": {}
      }
     }
    },
    "description": "Without limit: every UTXO. With limit (1-500): newest first, X-Total-Count and X-Total-Amount headers.",
    "parameters": [
     {
      "name": "address",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      },
      "description": "Karlsen address, e.g. karlsen:qr…"
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer"
      },
      "description": "Page size"
     },
     {
      "name": "offset",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "default": 0
      },
      "description": "Rows to skip"
     }
    ]
   }
  },
