  "/blocks/{block_id}": {
   "get": {
    "tags": [
     "Karlsen blocks"
    ],
    "summary": "Get block",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {}
      }
     }
    },
    "parameters": [
     {
      "name": "block_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      },
      "description": "Block hash"
     },
     {
      "name": "includeTransactions",
      "in": "query",
      "required": false,
      "schema": {
       "type": "boolean",
       "default": true
      }
     },
     {
      "name": "includeColor",
      "in": "query",
      "required": false,
      "schema": {
       "type": "boolean",
       "default": false
      }
     }
    ]
   }
  },
  "/blocks": {
   "get": {
    "tags": [
     "Karlsen blocks"
    ],
    "summary": "Get blocks from low hash",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {}
      }
     }
    },
    "parameters": [
     {
      "name": "lowHash",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "includeBlocks",
      "in": "query",
      "required": false,
      "schema": {
       "type": "boolean",
       "default": false
      }
     },
     {
      "name": "includeTransactions",
      "in": "query",
      "required": false,
      "schema": {
       "type": "boolean",
       "default": false
      }
     }
    ]
   }
  },
  "/transactions/{transaction_id}": {
   "get": {
    "tags": [
     "Karlsen transactions"
    ],
    "summary": "Get transaction",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {}
      }
     }
    },
    "parameters": [
     {
      "name": "transaction_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "inputs",
      "in": "query",
      "required": false,
      "schema": {
       "type": "boolean",
       "default": true
      }
     },
     {
      "name": "outputs",
      "in": "query",
      "required": false,
      "schema": {
       "type": "boolean",
       "default": true
      }
     },
     {
      "name": "resolve_previous_outpoints",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "default": "no"
      },
      "description": "no | light | full"
     },
     {
      "name": "blockHash",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      }
     }
    ]
   }
  },
  "/transactions/search": {
   "post": {
    "tags": [
     "Karlsen transactions"
    ],
    "summary": "Search transactions",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {}
      }
     }
    },
    "description": "POST only. Body holds transactionIds or an acceptingBlueScores range.",
    "parameters": [
     {
      "name": "fields",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      },
      "description": "Comma-separated field list"
     },
     {
      "name": "resolve_previous_outpoints",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "default": "no"
      }
     },
     {
      "name": "acceptance",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      },
      "description": "accepted | rejected"
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "transactionIds": {
          "type": "array",
          "items": {
           "type": "string"
          }
         },
         "acceptingBlueScores": {
          "type": "object",
          "properties": {
           "gte": {
            "type": "integer"
           },
           "lt": {
            "type": "integer"
           }
          }
         }
        }
       }
      }
     }
    }
   }
  },
