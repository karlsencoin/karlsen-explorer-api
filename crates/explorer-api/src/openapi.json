{
 "openapi": "3.0.3",
 "info": {
  "title": "Karlsen REST API",
  "version": "0.1.0",
  "description": "Public REST API of the Karlsen network (karlsen-explorer-api). Amounts are in sompi (1 KLS = 100,000,000 sompi) unless stated otherwise.\n\nSource: https://github.com/karlsencoin/karlsen-explorer-api"
 },
 "servers": [
  {
   "url": "/"
  }
 ],
 "paths": {
  "/info/blockdag": {
   "get": {
    "tags": [
     "Karlsen network info"
    ],
    "summary": "Get BlockDAG info",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {}
      }
     }
    },
    "description": "Block count, DAA score, difficulty, tips, pruning point."
   }
  },
  "/info/network": {
   "get": {
    "tags": [
     "Karlsen network info"
    ],
    "summary": "Get network info",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {}
      }
     }
    },
    "description": "Alias of /info/blockdag."
   }
  },
  "/info/hashrate": {
   "get": {
    "tags": [
     "Karlsen network info"
    ],
