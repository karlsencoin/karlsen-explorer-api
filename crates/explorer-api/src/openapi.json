     "200": {
      "description": "OK",
      "content": {
       "application/json": {}
      }
     }
    },
    "parameters": [
     {
      "name": "stringOnly",
      "in": "query",
      "required": false,
      "schema": {
       "type": "boolean",
       "default": false
      },
      "description": "Return the bare value as plain text"
     }
    ]
   }
  },
